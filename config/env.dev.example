# Local dev: app code runs on host, infra in Docker (compose.dev.yml).
OPENINTERVIEW_ENV=local

# Storage
STORAGE_BACKEND=local
OPENINTERVIEW_DATA_DIR=./data

# Database (postgres in Docker, port 55432 on host to avoid native Postgres conflict)
DATABASE_URL=postgresql+asyncpg://openinterview:openinterview@localhost:55432/openinterview

# Vector store (chroma in Docker, port 8001 on host)
VECTOR_BACKEND=chroma
CHROMA_URL=http://localhost:8001

# Gateway (host process)
GATEWAY_URL=http://localhost:9100
GATEWAY_SERVICE_TOKEN=dev-service-token-change-me

# Security
OPENINTERVIEW_MASTER_KEY=dev-master-key-change-me-32bytes!
JWT_SECRET=dev-jwt-secret-change-me-please-32b
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# Workers (host)
WORKER_BACKEND=arq
REDIS_URL=redis://localhost:56379/0

# Core API (host)
CORE_HOST=0.0.0.0
CORE_PORT=8000

# Gateway service (host) — using 9100 to avoid macOS port-9000 conflicts
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9100

# Realtime gateway (host) — live audio WebSocket
REALTIME_HOST=0.0.0.0
REALTIME_PORT=9200
REALTIME_PUBLIC_URL=ws://localhost:9200/ws/interview
OPENINTERVIEW_REALTIME_SECRET=dev-realtime-secret-change-me-32bytes
REALTIME_INTERNAL_TOKEN=dev-internal-token-change-me
REALTIME_MAX_TURN_SECONDS=90
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_NOISE_REDUCTION=near_field
REALTIME_TURN_DETECTION=semantic_vad
REALTIME_SPEAKER_VERIFIER_BACKEND=speechbrain
REALTIME_SPEAKER_THRESHOLD=0.25
REALTIME_CALIBRATION_SECONDS=5.0
REALTIME_MIN_TURN_AUDIO_MS=300
REALTIME_MIN_TRANSCRIPT_CONFIDENCE=0.35
REALTIME_VAD_EAGERNESS=low
REALTIME_TURN_COMMIT_DELAY_MS=1200
REALTIME_DEBUG_AUDIO_DIR=

LOG_LEVEL=INFO
LOG_JSON=false

# WhatsApp Bridge (Node sidecar running Baileys; pairs personal numbers)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:9300
WHATSAPP_BRIDGE_TOKEN=dev-bridge-token
WHATSAPP_BRIDGE_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/whatsapp/
WHATSAPP_BRIDGE_WEBHOOK_SECRET=dev-webhook-secret
WHATSAPP_BRIDGE_DATA_DIR=./data/whatsapp
