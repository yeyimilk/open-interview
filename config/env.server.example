OPENINTERVIEW_ENV=server

# Storage (pick one cloud backend)
STORAGE_BACKEND=s3
S3_BUCKET=openinterview-prod
S3_PREFIX=openinterview
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via IAM role or env

# Or Azure
# STORAGE_BACKEND=azure
# AZURE_STORAGE_ACCOUNT=...
# AZURE_STORAGE_CONTAINER=openinterview
# AZURE_STORAGE_SAS_OR_KEY=...

# Or GCS
# STORAGE_BACKEND=gcs
# GCS_BUCKET=openinterview-prod
# GCS_PREFIX=openinterview

DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/openinterview
VECTOR_BACKEND=chroma
CHROMA_URL=http://chroma:8000

GATEWAY_URL=http://gateway:9000
GATEWAY_SERVICE_TOKEN=__set_strong_token__

OPENINTERVIEW_MASTER_KEY=__32+_byte_secret__
JWT_SECRET=__strong_secret__
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

WORKER_BACKEND=arq
REDIS_URL=redis://redis:6379/0

CORE_HOST=0.0.0.0
CORE_PORT=8000
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
