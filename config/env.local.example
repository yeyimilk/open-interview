OPENINTERVIEW_ENV=local

# Storage
STORAGE_BACKEND=local
OPENINTERVIEW_DATA_DIR=./data

# Database
DATABASE_URL=postgresql+asyncpg://openinterview:openinterview@postgres:5432/openinterview

# Vector store
VECTOR_BACKEND=chroma
CHROMA_URL=http://chroma:8000

# Gateway
GATEWAY_URL=http://gateway:9000
GATEWAY_SERVICE_TOKEN=dev-service-token-change-me

# Security
OPENINTERVIEW_MASTER_KEY=dev-master-key-change-me-32bytes!
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# Workers
WORKER_BACKEND=arq
REDIS_URL=redis://redis:6379/0

# Core API
CORE_HOST=0.0.0.0
CORE_PORT=8000

# Gateway service (own settings)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
